node_modules
dist
.zames
*.log
tmp/
.husky/_

# A tool call that omitted its path used to create this file by accident.
# Kept as a safety net so it never reaches a commit.
undefined

# Per-project local settings. Kept out of git so personal toggles
# (e.g. confirmation.*) never ship with the package.
.zamesrc.json
# Per-project session goal (/goal) — personal state, not part of the package.
.zames-goal
commit-msg.tmp

# Agent-generated working notes. The agent rewrites this file constantly and
# used to commit it on every task; keep it OUT of the repo so a self-update
# never lands it in a release.
BACKLOG.md

# One-off TUI pty probes/drivers written per-bug during development. Kept
# locally (useful to reproduce a rendering regression by hand) but not tracked:
# their checks are already covered by unit tests and they only bloat the repo.
scripts/dev-probes/

# Local draft of the next TUI work plan — a scratchpad, not part of the repo.

# The agent's own bug-hunting journal (like BACKLOG.md): rewritten during
# development cycles, must never ship with a release.
QUEUE.md

# Long GLM run artifacts (agent-generated, not part of the package).
GLM_RUN_REPORT.md
GLM_LONG_RUN_TASK.md
