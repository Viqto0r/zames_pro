{
  "name": "zames_pro",
  "version": "2.72.0",
  "description": "Terminal coding agent that drives chat.deepseek.com through Playwright — no API key required. Reads and edits files, runs commands, commits to git, like Claude Code / Codex CLI.",
  "type": "module",
  "bin": {
    "zames": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "logo-small.jpg"
  ],
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "ZAMES_NET_DEBUG=1 tsx ./src/index.ts --dev --headed",
    "clean": "tsx scripts/clean-dist.mts",
    "build": "tsx scripts/clean-dist.mts && tsc -p tsconfig.build.json",
    "coverage:gate": "tsx scripts/coverage-gate.mts",
    "changelog:draft": "tsx scripts/changelog-draft.mts",
    "changelog:sync": "tsx scripts/changelog-draft.mts --write",
    "changelog:check": "tsx scripts/changelog-draft.mts --check",
    "release": "tsx scripts/release.mts",
    "typecheck": "tsc --noEmit",
    "lint": "tsx scripts/eslint-ts6.mts",
    "lint:fix": "tsx scripts/eslint-ts6.mts --fix",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\" \"*.{js,json,md}\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"test/**/*.ts\"",
    "prepublishOnly": "npm run build:readme && npm run build",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "self-smoke": "tsx scripts/self-smoke.mts",
    "render-demo": "tsx scripts/render-demo.mts",
    "build:readme": "tsx scripts/build-readme.mts",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "agent",
    "ai",
    "ai-agent",
    "ai-coding-assistant",
    "coding-agent",
    "code-assistant",
    "terminal-agent",
    "deepseek",
    "deepseek-chat",
    "claude-code",
    "codex",
    "cli",
    "terminal",
    "playwright",
    "browser-automation",
    "llm",
    "no-api-key",
    "automation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "npm@11.19.0",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.1",
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "markdansi": "^0.3.4",
    "ora": "^8.0.1",
    "playwright": "^1.48.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viqto0r/zames_pro.git"
  },
  "homepage": "https://github.com/Viqto0r/zames_pro#readme",
  "bugs": {
    "url": "https://github.com/Viqto0r/zames_pro/issues"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^26.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-6": "npm:typescript@^6.0.0-beta",
    "typescript-eslint": "^8.70.1"
  }
}
