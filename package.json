{
  "name": "zames_pro",
  "version": "2.9.3",
  "description": "Terminal coding agent over chat.deepseek.com via Playwright",
  "type": "module",
  "bin": {
    "zames": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "LICENSE",
    "logo.png"
  ],
  "scripts": {
    "start": "node ./dist/index.js",
    "dev": "tsx ./src/index.ts --dev",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build",
    "test": "tsx --test test/*.test.ts",
    "test:watch": "tsx --test --watch test/*.test.ts",
    "postinstall": "node scripts/postinstall.mjs",
    "prepare": "husky"
  },
  "keywords": [
    "agent",
    "ai",
    "deepseek",
    "cli",
    "coding-agent"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "cli-highlight": "^2.1.11",
    "markdansi": "^0.3.4",
    "marked": "^15.0.12",
    "ora": "^8.0.1",
    "playwright": "^1.48.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Viqto0r/zames_pro.git"
  },
  "homepage": "https://github.com/Viqto0r/zames_pro#readme",
  "bugs": {
    "url": "https://github.com/Viqto0r/zames_pro/issues"
  },
  "devDependencies": {
    "@types/node": "^26.6.2",
    "husky": "^9.1.7",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
