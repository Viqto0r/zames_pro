// Render CHANGELOG.md into the GitHub Pages changelog pages.
//
// Why the site needs its own copy: GitHub renders CHANGELOG.md, but the site is
// the place a visitor looks for "what changed lately", and a link to the raw
// blob throws them out of the site (and a Russian reader into English). The
// 294 releases are also 2800 lines of Markdown — on a plain doc page that is
// one endless scroll, so the page gets a per-release list with collapsible
// old versions and a jump list.
//
// Why generated and not hand-written: CHANGELOG.md is written by `npm run
// release` and `changelog:sync` on every release; a hand-kept page would drift
// after the first one. The page is committed, and test/docs-changelog.test.ts
// re-runs buildChangelogPages() so a drift fails CI exactly like the README
// pages.
//
// Usage:  npm run build:changelog           (write docs/changelog.md + -ru.md)
//         npm run build:changelog -- --check (exit 1 when a page drifted)

import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { changelogGroupLabel, siteUi } from './site-ui.mts'

// Same reason as in site-ui.mts: the pages are generated by `tsx` from the repo
// root, so a `../src/i18n.js` specifier would need a build first.
type Locale = 'ru' | 'en'

const NL = String.fromCharCode(10)
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')

// A release newer than this is expanded by default; everything older is
// folded into a <details>, because 294 open sections bury the latest release.
const OPEN_RELEASES = 3

// The changelog pages are linked from the doc nav and the landing card grid;
// the English one is the canonical URL and the Russian one its alternate.
const PAGES: Record<Locale, string> = {
  en: 'docs/changelog.md',
  ru: 'docs/changelog-ru.md',
}

function escapeHtml(s: string): string {
  return s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
}

// The inline Markdown CHANGELOG.md actually uses: `code`, **bold** and
// [text](url). Anything else is left as plain text on purpose — the file is
// not a CommonMark document and a half-implemented parser is worse than none.
function inline(s: string): string {
  return escapeHtml(s)
    .replace(/\[([^\]]+)\]\(([^)]+)\)/g, '<a href="$2">$1</a>')
    .replace(/`([^`]+)`/g, '<code>$1</code>')
    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
}

function renderList(items: string[]): string {
  const out: string[] = []
  for (const line of items) {
    if (/^\s*- /.test(line)) {
      out.push('<li>' + inline(line.replace(/^\s*- /, '')))
    } else if (out.length > 0) {
      out[out.length - 1] += ' ' + inline(line.trim())
    }
  }
  return out.map((li) => (li.endsWith('</li>') ? li : li + '</li>')).join(NL)
}

interface Release {
  version: string
  date: string
  groups: Array<{ name: string; items: string[] }>
}

// The link-reference block at the bottom of CHANGELOG.md is navigation for
// GitHub's compare view, not release text, so the renderer stops before it.
export function parseChangelog(text: string): Release[] {
  const lines = text.split(/\r?\n/)
  const start = lines.findIndex((l) => l.startsWith('## ['))
  if (start < 0) return []
  const end = lines.findIndex((l) => /^\[[^\]]+\]:/.test(l))
  const body = lines.slice(start, end < 0 ? lines.length : end)

  const releases: Release[] = []
  let release: Release | null = null
  let group = 'Other'
  for (const raw of body) {
    const line = raw.trimEnd()
    const h2 = /^## (.+)$/.exec(line.trim())
    if (h2) {
      const m = /^\[([^\]]+)\](?: - (\d{4}-\d{2}-\d{2}))?$/.exec(h2[1].trim())
      if (!m) {
        release = null
        continue
      }
      release = { version: m[1], date: m[2] || '', groups: [] }
      releases.push(release)
      group = 'Other'
      continue
    }
    const h3 = /^### (.+)$/.exec(line.trim())
    if (h3) {
      group = h3[1].trim()
      continue
    }
    if (!release) continue
    if (!line.trim()) continue
    let g = release.groups.find((x) => x.name === group)
    if (!g) {
      g = { name: group, items: [] }
      release.groups.push(g)
    }
    g.items.push(line)
  }
  return releases
}

function anchor(version: string): string {
  return 'v' + version.replace(/[^A-Za-z0-9._-]/g, '-')
}

function renderRelease(
  rel: Release,
  i: number,
  locale: Locale,
  ui: ReturnType<typeof siteUi>,
): string {
  const open = i < OPEN_RELEASES
  const version = rel.version === 'Unreleased' ? rel.version : rel.version
  const groups = rel.groups
    .filter((g) => g.items.length > 0)
    .map(
      (g) =>
        '<section class="ch-group"><h3>' +
        escapeHtml(changelogGroupLabel(locale, g.name)) +
        '</h3>' +
        NL +
        '<ul>' +
        NL +
        renderList(g.items) +
        NL +
        '</ul></section>',
    )
    .join(NL)
  const head =
    '<header><h2>' +
    (rel.version === 'Unreleased'
      ? escapeHtml(rel.version)
      : 'v' + escapeHtml(rel.version)) +
    '</h2>' +
    (rel.date
      ? '<time datetime="' + rel.date + '">' + rel.date + '</time>'
      : '') +
    '</header>'
  // A <details> without JS gives the fold for free and keeps a deep link
  // working: an id on the <details> is what the jump list targets.
  return (
    '<details class="ch-release" id="' +
    anchor(rel.version) +
    '"' +
    (open ? ' open' : '') +
    '>' +
    NL +
    '<summary>' +
    head +
    '</summary>' +
    NL +
    (groups || '<p class="ch-empty">—</p>') +
    NL +
    '</details>'
  )
}

function frontMatter(locale: Locale): string {
  const ui = siteUi(locale).changelog
  return [
    '---',
    'layout: doc',
    'title: ' + JSON.stringify(ui.title),
    'description: ' + JSON.stringify(ui.description),
    'lang: ' + locale,
    'alt_url: ' + (locale === 'ru' ? '/changelog.html' : '/changelog-ru.html'),
    'changelog: true',
    '---',
    '',
  ].join(NL)
}

export function buildChangelogPages(rootDir: string): {
  en: string
  ru: string
} {
  const text = fs.readFileSync(path.join(rootDir, 'CHANGELOG.md'), 'utf-8')
  const releases = parseChangelog(text)
  const page = (locale: Locale): string => {
    const ui = siteUi(locale).changelog
    const body = releases
      .map((r, i) => renderRelease(r, i, locale, siteUi(locale)))
      .join(NL)
    // The release count is printed, not counted by JS: a JS-off visitor and a
    // crawler see the same number. The jump list carries the date so a version
    // is findable by WHEN it shipped, not only by its number.
    const jump = releases
      .map((r) => {
        const label =
          r.version === 'Unreleased'
            ? escapeHtml(r.version)
            : 'v' + escapeHtml(r.version)
        return (
          '<a href="#' +
          anchor(r.version) +
          '"><span>' +
          label +
          '</span>' +
          (r.date
            ? '<time datetime="' + r.date + '">' + r.date + '</time>'
            : '') +
          '</a>'
        )
      })
      .join(NL)
    return (
      frontMatter(locale) +
      '<div class="wrap" markdown="1">' +
      NL +
      '<p class="changelog-lead">' +
      escapeHtml(ui.lead) +
      ' (' +
      escapeHtml(ui.count(releases.length)) +
      ')</p>' +
      NL +
      '<nav class="changelog-jump" aria-label="' +
      escapeHtml(ui.jump) +
      '">' +
      NL +
      jump +
      NL +
      '</nav>' +
      NL +
      body +
      NL +
      '</div>' +
      NL
    )
  }
  return { en: page('en'), ru: page('ru') }
}

const invoked =
  process.argv[1] &&
  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
if (invoked) {
  const pages = buildChangelogPages(root)
  const targets = [path.join(root, PAGES.en), path.join(root, PAGES.ru)]
  const contents = [pages.en, pages.ru]
  if (process.argv.includes('--check')) {
    const drifted = targets.filter(
      (file, i) => fs.readFileSync(file, 'utf-8') !== contents[i],
    )
    if (drifted.length > 0) {
      console.error(
        'build-changelog: ' +
          drifted.map((f) => path.basename(f)).join(', ') +
          ' drifted from CHANGELOG.md — run `npm run build:changelog`',
      )
      process.exit(1)
    }
    console.log('build-changelog: pages are up to date')
  } else {
    targets.forEach((file, i) => fs.writeFileSync(file, contents[i]))
    console.log('build-changelog: wrote ' + PAGES.en + ', ' + PAGES.ru)
  }
}
