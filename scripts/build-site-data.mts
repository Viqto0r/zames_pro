// Generate docs/_data/site_ui.yml — the layout strings the Jekyll pages read.
//
// Why a generated data file: the RU/EN site strings live in site-ui.mts, next to
// the other generated pages and covered by the test suite. Jekyll cannot read a
// .mts, so the table is serialized into a YAML data file; every include then
// reads `site.data.site_ui[page.lang]`, which keeps ONE source of truth for a
// page that must exist in two languages.
//
// Usage:  npm run build:site-data           (write docs/_data/site_ui.yml)
//         npm run build:site-data -- --check (exit 1 when the file drifted)

import fs from 'node:fs'
import path from 'node:path'
import { fileURLToPath } from 'node:url'
import { SITE_UI, type SiteUi } from './site-ui.mts'

const NL = String.fromCharCode(10)
const root = path.resolve(path.dirname(fileURLToPath(import.meta.url)), '..')
export const SITE_UI_PATH = 'docs/_data/site_ui.yml'

// A YAML scalar. The rules are the ones a hand-written data file would follow:
// a plain scalar may not contain `: `, ` #`, start with an indicator character
// (`&`, `*`, `!`, `[`, `{`, ...) or look like a number/boolean/null. Everything
// else is single-quoted, which also protects `Commands & tools` (an `&` at the
// start of a scalar is a YAML anchor) and `Sign-in and captcha`.
function scalar(value: string, flow = false): string {
  const plainOk =
    value !== '' &&
    !/^[\-?:,[\]{}#&*!|>'"%@`]/.test(value) &&
    // In a FLOW sequence (`[a, b]`) a comma ends the scalar, so a value with a
    // comma inside must be quoted there even though block style allows it.
    (!flow || !/[,\[\]{}]/.test(value)) &&
    !/[:#]\s/.test(value) &&
    !/\s#/.test(value) &&
    !/^(true|false|null|yes|no|on|off|~)$/i.test(value) &&
    !/^[-+]?(\d[\d_]*)?(\.\d*)?([eE][-+]?\d+)?$/.test(value)
  return plainOk ? value : "'" + value.replace(/'/g, "''") + "'"
}

// The JSON-ish render of a string with HTML entities (`Commands &amp; tools`)
// is what the page prints verbatim, so nothing is escaped here.
function renderUi(locale: 'en' | 'ru', ui: SiteUi): string[] {
  const out: string[] = []
  out.push('  ' + locale + ':')
  out.push('    changelog:')
  out.push('      title: ' + scalar(ui.changelog.title))
  out.push('      description: ' + scalar(ui.changelog.description))
  out.push('      lead: ' + scalar(ui.changelog.lead))
  out.push('      jump: ' + scalar(ui.changelog.jump))
  out.push('      unavailable: ' + scalar(ui.changelog.unavailable))
  out.push('    themes:')
  out.push('      legend: ' + scalar(ui.themes.legend))
  out.push('    landing:')
  out.push('      docsHeading: ' + scalar(ui.landing.docsHeading))
  out.push('      docsLead: ' + scalar(ui.landing.docsLead))
  out.push('      cards:')
  for (const card of ui.landing.cards) {
    // Array.from, not card.map: a callback's second parameter would be the
    // INDEX, and scalar(v, true) is the flow-sequence flag.
    out.push(
      '        - [' + Array.from(card, (v) => scalar(v, true)).join(', ') + ']',
    )
  }
  out.push('    docsNav:')
  out.push('      changelog: ' + scalar(ui.docsNav.changelog))
  return out
}

export function buildSiteData(): string {
  return (
    [
      '# Generated by scripts/build-site-data.mts from scripts/site-ui.mts.',
      '# Do not edit by hand: `npm run build:site-data` rewrites this file and',
      '# test/docs-changelog.test.ts fails when it drifts.',
      ...renderUi('en', SITE_UI.en),
      ...renderUi('ru', SITE_UI.ru),
    ].join(NL) + NL
  )
}

const invoked =
  process.argv[1] &&
  path.resolve(process.argv[1]) === fileURLToPath(import.meta.url)
if (invoked) {
  const text = buildSiteData()
  const target = path.join(root, SITE_UI_PATH)
  if (process.argv.includes('--check')) {
    const onDisk = fs.existsSync(target) ? fs.readFileSync(target, 'utf-8') : ''
    if (onDisk !== text) {
      console.error(
        'build-site-data: ' +
          SITE_UI_PATH +
          ' drifted from scripts/site-ui.mts — run `npm run build:site-data`',
      )
      process.exit(1)
    }
    console.log('build-site-data: ' + SITE_UI_PATH + ' is up to date')
  } else {
    fs.writeFileSync(target, text)
    console.log('build-site-data: wrote ' + SITE_UI_PATH)
  }
}
